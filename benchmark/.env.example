# Gurobi license configuration - copy this file to `benchmark/.env`
# (it is gitignored) and fill in your values, OR place `benchmark/gurobi.lic`
# (also gitignored). Both are consumed by the devcontainer's postCreate.sh.
#
# Option A - local (named/user) license file:
#   place gurobi.lic in this directory or in .devcontainer/
#
# Option B - WLS / floating licenses (recommended for containers):
#   GRB_WLSACCESSID=<your access id>
#   GRB_WLSPASSWORD=<your password>
#   GRB_LICENSEID=<optional license id>
# Optional overrides:
#   GRB_LICENSE_FILE=/path/to/gurobi.lic
#   GUROBI_HOME=/opt/gurobi/...    (only needed if not using the pip wheel)
